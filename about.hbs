<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>TracePulse - Third Party Licenses</title>
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
            background: #1a1a1a;
            color: #eee;
        }

        h1 {
            border-bottom: 2px solid #444;
            padding-bottom: 10px;
        }

        .license {
            background: #2a2a2a;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        pre {
            background: #111;
            padding: 10px;
            overflow-x: auto;
            font-size: 0.9em;
        }
    </style>
</head>

<body>
    <h1>TracePulse Third-Party Licenses</h1>
    <p>This software utilizes the following open-source libraries:</p>
    <div class="license">
        <h2>Runtime Web Assets</h2>
        <ul>
            <li><strong>Apache ECharts</strong> 6.1.0 - Apache License 2.0</li>
            <li><strong>zrender</strong> 6.1.0 - BSD 3-Clause</li>
            <li><strong>tslib</strong> 2.3.0 - 0BSD</li>
        </ul>
        <p>The Apache ECharts attribution is preserved in its upstream
            <code>NOTICE</code> file. The complete npm dependency versions are
            recorded in <code>package-lock.json</code>.
        </p>
    </div>
    {{#each licenses}}
    <div class="license">
        <h2>{{name}}</h2>
        <p>Used by:
        <ul>
            {{#each used_by}}
            <li><strong>{{crate.name}}</strong> {{crate.version}}</li>
            {{/each}}
        </ul>
        </p>
        <pre>{{text}}</pre>
    </div>
    {{/each}}
</body>

</html>